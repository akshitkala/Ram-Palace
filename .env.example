# BRP-FIX: F-3
# Basti Ram Palace — Environment Variables Template

# App
# Use the production domain (e.g., https://ram-palace.vercel.app or https://bastirampalace.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth
# Create a strong secret for JWT signing
JWT_SECRET=your_jwt_secret_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# Email (Resend)
RESEND_API_KEY=re_123...
FROM_EMAIL=onboarding@resend.dev
FROM_NAME="Basti Ram Palace"

# Venue Notifications
OWNER_EMAIL_1=your-email@example.com
OWNER_EMAIL_2=
OWNER_EMAIL_3=

# Cloudinary (Remote Images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
